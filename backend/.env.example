# ==== App ====
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
EMERGENCY_NUMBER=your local emergency number

# ==== Supabase (optional — leave blank to use the in-memory store) ====
SUPABASE_URL=https://ehmsuelhfxabyjzdokjr.supabase.co
SUPABASE_ANON_KEY=sb_publishable_qXeRs9R_AlHfTxXfelJaDg_kwflUVfY
# SERVER-SIDE ONLY. Never expose to the frontend (PRD sections 22, 27).
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://ehmsuelhfxabyjzdokjr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qXeRs9R_AlHfTxXfelJaDg_kwflUVfY

# ==== LLM ====
# provider: anthropic | openai | none  (none = deterministic offline fallback)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# LLM_BASE_URL=   # for OpenAI-compatible gateways

# ==== Embeddings ====
# provider: openai | local  (local = deterministic offline fallback)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BASE_URL=

# ==== Rate limiting (PRD section 40) ====
RATE_LIMIT_ANONYMOUS_PER_HOUR=20
RATE_LIMIT_AUTHENTICATED_PER_HOUR=100

# ==== Medical report upload & analysis ====
# OCR (scanned PDFs / images) requires Tesseract OCR + Poppler installed locally
# (not pip-installable). See README "Report analysis setup".
REPORT_MAX_FILE_SIZE_MB=10
REPORT_STORAGE_BUCKET=medical-reports
OCR_LANGUAGE=eng
